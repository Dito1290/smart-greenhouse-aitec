# ==============================================================================
# AI Greenhouse Companion — backend gateway
# Salin ke .env lalu isi. Jangan commit file .env.
# ==============================================================================

PORT=5050
# Batasi ke 127.0.0.1 bila backend hanya diakses lewat tunnel.
HOST=0.0.0.0

# Token akses aplikasi mobile (minimal 16 karakter, acak). Wajib.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_ACCESS_TOKEN=replace_with_long_random_token

# MQTT broker (sesuai firmware ESP32)
MQTT_HOST=sdp.polinela.ac.id
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
# Kosongkan untuk client id acak; JANGAN sama dengan client id ESP32.
MQTT_CLIENT_ID=
MQTT_SENSOR_TOPIC=environment/data
MQTT_RELAY_TOPIC=relay/control

# Data dianggap basi bila tidak ada pesan baru selama ini (firmware ~5 detik).
STALE_AFTER_MS=20000

# Gemini (server-side saja)
GEMINI_API_KEY=your_gemini_api_key
# gemini-3.5-flash sudah digantikan gemini-3.6-flash (lihat ai.google.dev/gemini-api/docs/deprecations).
GEMINI_MODEL=gemini-3.6-flash
# Opsional: model cadangan, dipakai bila model utama terus gagal sementara (503/429/5xx/timeout) atau kuota hariannya habis.
# Disarankan: gemini-3.5-flash-lite (kuota terpisah). Kosongkan untuk menonaktifkan.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Batas waktu per percobaan, dan total semua percobaan + jeda (harus < 60 s, batas waktu aplikasi).
GEMINI_TIMEOUT_MS=30000
GEMINI_TOTAL_TIMEOUT_MS=45000
# Jumlah percobaan ulang per model untuk galat sementara (0–5). Galat permanen tidak diulang.
GEMINI_MAX_RETRIES=2
# LOW = cepat (default), MEDIUM/HIGH = lebih teliti tapi lambat
GEMINI_THINKING_LEVEL=LOW

# Riwayat percakapan yang diteruskan ke Gemini per pertanyaan (tidak disimpan di server).
CHAT_HISTORY_TURNS=12
CHAT_HISTORY_CHARS=16000

# Riwayat sensor (snapshot JSON lokal)
HISTORY_FILE=./data/history.json
HISTORY_HOURS=24
