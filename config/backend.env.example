# Backend Environment Variables Configuration
# Copy this file to .env and update values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ============================================================================
# MQTT BROKER CONFIGURATION
# ============================================================================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=greenhouse_user
MQTT_PASSWORD=your_secure_password
MQTT_CLIENT_ID=greenhouse_backend

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Option 1: InfluxDB (Recommended untuk time-series data)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=greenhouse_org
INFLUXDB_BUCKET=greenhouse_data

# Option 2: MongoDB (Alternative)
# MONGODB_URI=mongodb://localhost:27017/greenhouse
# MONGODB_DATABASE=greenhouse

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ============================================================================
# API RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGIN=http://localhost:3001,https://yourdomain.com
CORS_CREDENTIALS=true

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info  # error, warn, info, debug
LOG_FILE=./logs/greenhouse.log

# ============================================================================
# NOTIFICATIONS (Optional)
# ============================================================================
# Email notifications (using SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=admin@example.com

# Telegram Bot (untuk mobile notifications)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# ============================================================================
# DATA RETENTION
# ============================================================================
DATA_RETENTION_DAYS=90  # Delete data older than 90 days

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_PATH=./backups

# ============================================================================
# SECURITY
# ============================================================================
HELMET_ENABLED=true  # Enable security headers
BCRYPT_ROUNDS=10     # Password hashing rounds
